    "PreToolUse": [
      {
        "matcher": "mcp__.*robinhood.*__place_.*|mcp__.*robinhood.*__cancel_.*|mcp__.*robinhood.*__exercise_.*",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$CLAUDE_PROJECT_DIR\"/.claude/hooks/order_guard.py || { echo 'ORDER GUARD FAILED TO RUN: blocking' >&2; exit 2; }",
            "timeout": 10
          }
        ]
      }
